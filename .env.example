LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Backward compatible DeepSeek config. You can omit these if LLM_* is set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Default is offline and requires no model download.
EMBEDDING_BACKEND=hash

# Optional: set EMBEDDING_BACKEND=sentence-transformers to use this model.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=local-v1
# Models must already be cached/local. No automatic downloads.
# UI-saved data/settings.json takes priority over these defaults.
RERANKER=lightweight
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HISTORY_CHARS=6000
HISTORY_TURNS=6
CANDIDATE_K=20
# Optional absolute directory; default is data/ beside main.py.
# RAG_DATA_DIR=D:/rag-studio-data

# Optional tuning.
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
